# Environment variables for AI Laboratory
# Copy this file to .env and fill in the values

# PostgreSQL
POSTGRES_DB=ai_laboratory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=change-me-to-a-random-base64-encoded-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
SPRING_PROFILES_ACTIVE=prod

# Object storage
# Local docker-compose uses MinIO with S3-compatible APIs. Use strong values in real environments.
MINIO_ROOT_USER=ailab
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
APP_STORAGE_PROVIDER=s3
APP_STORAGE_ENDPOINT=http://ailab-minio:9000
APP_STORAGE_REGION=us-east-1
APP_STORAGE_BUCKET=ailab-assets
APP_STORAGE_ACCESS_KEY=ailab
APP_STORAGE_SECRET_KEY=change-me-minio-password
APP_STORAGE_PATH_STYLE=true
APP_STORAGE_CREATE_BUCKET=true
APP_STORAGE_DOWNLOAD_URL_TTL=PT10M
APP_STORAGE_MAX_ASSET_SIZE=10MB
APP_STORAGE_MAX_AVATAR_SIZE=2MB
APP_STORAGE_MAX_PREVIEW_SIZE=10MB

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Mail / SMTP (Mailpit for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@ailab.local
APP_FRONTEND_URL=http://localhost:3000

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=